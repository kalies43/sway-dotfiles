{
    "layer": "top",
    "position": "right",
    "width": 54,
    "spacing": 4,

    "modules-left": ["sway/workspaces"],
    "modules-center": ["custom/spotify", "tray"],
    "modules-right": ["cpu", "memory", "network", "pulseaudio", "custom/easyeffects", "custom/clock", "group/power"],

    "sway/workspaces": {
        "orientation": "vertical",
        "format": "{index}"
    },

    "custom/spotify": {
        "exec": "~/.config/waybar/scripts/spotify.sh",
        "return-type": "json",
        "interval": 2
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "cpu": {
        "format": "",
        "tooltip-format": "CPU: {usage}%",
        "interval": 3
    },

    "memory": {
        "format": "",
        "tooltip-format": "RAM: {percentage}%",
        "interval": 5
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{volume}%",
        "on-click": "pavucontrol"
    },

    "custom/easyeffects": {
        "format": "",
        "on-click": "easyeffects",
        "tooltip-format": "EasyEffects"
    },

    "custom/clock": {
        "exec": "~/.config/waybar/scripts/clock.sh",
        "return-type": "json",
        "interval": 30,
        "tooltip": false
    },

    "group/power": {
        "orientation": "vertical",
        "drawer": {
            "transition-duration": 300,
            "children-class": "power-drawer",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power",
            "custom/lock",
            "custom/sleep",
            "custom/reboot",
            "custom/shutdown"
        ]
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false
    },
    "custom/lock": {
        "format": "",
        "on-click": "swaylock -f",
        "tooltip-format": "Lock"
    },
    "custom/sleep": {
        "format": "☾",
        "on-click": "systemctl suspend",
        "tooltip-format": "Sleep"
    },
    "custom/reboot": {
        "format": "⟳",
        "on-click": "systemctl reboot",
        "tooltip-format": "Restart"
    },
    "custom/shutdown": {
        "format": "⏼",
        "on-click": "systemctl poweroff",
        "tooltip-format": "Shutdown"
    }
}
